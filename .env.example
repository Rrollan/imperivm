# Public configuration IDs, never wallet keys. Restart/rebuild after editing.
# A missing or placeholder Title ID activates persistent local demo mode.
NEXT_PUBLIC_IDOS_TITLE_ID=YOUR_TITLE_ID
NEXT_PUBLIC_IDOS_COLLECTION_ID=IMPERIVM_AGORA
NEXT_PUBLIC_IDOS_PACK_TYPE_ID=AGORA_PACK
NEXT_PUBLIC_IDOS_CURRENCY_ID=IMP
NEXT_PUBLIC_IDOS_PRICE_OPTION_ID=IMP
NEXT_PUBLIC_IDOS_LEADERBOARD_ID=
# iDos Blockchain.Networks dictionary key. Type=Solana, RpcUrl=https://api.devnet.solana.com
# Keep PlayAccess.Mode=Open and TokenGates=[] until a devnet token exists.
NEXT_PUBLIC_IDOS_SOLANA_NETWORK_ID=SOLANA_DEVNET

# Mainnet IMP top-ups: disabled until Title configuration and a live platform test.
# Details: docs/economy-idos-rug.md. Never put keys / session tickets here.
NEXT_PUBLIC_IDOS_COMMERCE_ENABLED=false
NEXT_PUBLIC_IDOS_IMP_STORE_ID=IMPERIVM_IMP
NEXT_PUBLIC_IDOS_COMMERCE_NETWORK_ID=SOLANA_MAINNET
NEXT_PUBLIC_IDOS_SOL_CURRENCY_ID=SOL
NEXT_PUBLIC_IDOS_USDC_CURRENCY_ID=USDC
NEXT_PUBLIC_IDOS_APP_URL=

# WS SERVER ONLY: verify ownership for pack-exclusive custom decks.
IDOS_TITLE_ID=
IDOS_COLLECTION_ID=IMPERIVM_AGORA
IDOS_BUILD_KEY=

# Optional future DEVNET SPL mint. Leave empty until explicitly approved and created.
# Optional read-only devnet token display, separate from virtual IMP and mainnet checkout.
NEXT_PUBLIC_IMP_DEVNET_MINT=

# Actual HTTPS origin serving /api/nft/metadata/ and card art. Never localhost.
NEXT_PUBLIC_NFT_METADATA_BASE_URL=
NEXT_PUBLIC_GENESIS_COLLECTION=
NEXT_PUBLIC_GENESIS_CANDY_MACHINE=

# Optional indexer credential: SERVER ONLY. Never use a NEXT_PUBLIC_ prefix.
HELIUS_DEVNET_API_KEY=

# Server-only exact HTTPS origin for PvP POST checks (no trailing slash).
# Leave empty for a direct local next server. Single-process storage only: see docs/multiplayer-readiness.md.
MULTIPLAYER_PUBLIC_ORIGIN=

# Custom 1-vs-1 games use the separate Node WS service (server/README.md).
# Local: ws://127.0.0.1:3102. Deployed frontend: wss://YOUR-SERVICE.onrender.com
# NEXT_PUBLIC_ values are built into the frontend: rebuild/redeploy after editing.
NEXT_PUBLIC_WS_URL=
